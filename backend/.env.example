# Rename this file to .env and fill in your own values

# Get this connection string from MongoDB Atlas: Database > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/study-space-finder

# Any long random string works - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

PORT=5000
